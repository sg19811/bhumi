# ============================================================================
# AcreHub — environment template.  COPY this file to `.env.local` and fill in
# the real values.  NEVER commit `.env.local` (it's gitignored).  The real
# values live in your password manager / the Supabase + Vercel dashboards.
# ============================================================================

# ── REQUIRED (the app won't start without these) ────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # the "publishable" / anon key (sb_publishable_…) — safe in the browser
SUPABASE_SERVICE_ROLE_KEY=              # the "secret" key (sb_secret_…) — SERVER ONLY. Never prefix with NEXT_PUBLIC_.

# ── OPTIONAL (leave blank and the feature stays off) ────────────────────────
# Claude AI (farm-plot AI buyer report + listing assistant). console.anthropic.com
ANTHROPIC_API_KEY=                      # SERVER ONLY. Never prefix with NEXT_PUBLIC_.

# Analytics (render only when set)
NEXT_PUBLIC_GA_MEASUREMENT_ID=          # GA4, looks like G-XXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=               # defaults to https://us.i.posthog.com

# Email alerts + weekly intelligence digest (cron)
RESEND_API_KEY=
ALERT_FROM_EMAIL=
FOUNDER_EMAIL=
CRON_SECRET=                            # protects the cron routes
